# Bhagavad Gita — build/sign/publish, both platforms, both variants (Flutter-embedded and native).
#
# Run: .github/workflows/release.yml (jobs release-android-flutter / release-android-native /
# release-ios-flutter / release-ios-native), on a version tag push or manual workflow_dispatch.
# The actual .apk/.aab/.ipa is built by CI *before* calling these lanes (flutter build / gradle /
# xcodebuild, depending on platform_dir) — these lanes only sign-adjacent bookkeeping (Android
# App Bundle handled by CI's gradle/flutter invocation) and the real store upload.
#
# applicationId / bundle id: com.ethnoapp.bgita (same identity for both variants — see Appfile).
# Only one variant per platform is ever actually published for a given run — controlled by the
# `publish:` boolean CI passes in (native is the default target; see 03-plan.md Task 6.2/6.3).
#
# Secrets used by CI before invoking these lanes (see release.yml):
#   ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
#   PLAY_STORE_JSON_KEY            — Play Console service account JSON
#   IOS_CERT_P12_BASE64, IOS_CERT_PASSWORD, IOS_PROVISIONING_PROFILE_BASE64, IOS_TEAM_ID
#   APP_STORE_CONNECT_API_KEY_*    — App Store Connect API key (deliver)
#
# Before the first real release:
#   1. Play Console: create the app listing under com.ethnoapp.bgita (Google Play requires the
#      first .apk/.aab to be uploaded manually via the console — the API can't create a brand new
#      listing), then subsequent uploads can go through `supply`/upload_to_play_store.
#   2. App Store Connect: same — create the app record for com.ethnoapp.bgita first.
#   3. Add the secrets listed above in GitHub (Settings → Secrets and variables → Actions).

default_platform(:android)

platform :android do
  desc "Publish an already-built APK to Google Play. platform_dir: android (Flutter) or native/android (default)"
  lane :publish do |options|
    platform_dir = options[:platform_dir] || "native/android"
    publish_to_store = options.fetch(:publish, false)
    track = options[:track] || "internal"

    # native/android/app/build.gradle declares flavorDimensions "server" (dev/live) — "live" is the
    # production-API flavor and what actually gets published; the Flutter-embedded build.gradle.kts
    # has no flavors.
    apk_path =
      if platform_dir == "android"
        "#{platform_dir}/build/app/outputs/flutter-apk/app-release.apk"
      else
        "#{platform_dir}/app/build/outputs/apk/live/release/app-live-release.apk"
      end

    unless publish_to_store
      UI.message("publish:false for platform_dir=#{platform_dir} — build/sign only, skipping upload_to_play_store")
      next
    end

    upload_to_play_store(
      track: track,
      apk: apk_path,
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  desc "Publish an already-built/archived IPA to App Store Connect. platform_dir: ios (Flutter) or native/ios (default)"
  lane :publish do |options|
    platform_dir = options[:platform_dir] || "native/ios"
    publish_to_store = options.fetch(:publish, false)

    ipa_name = platform_dir == "ios" ? "Runner" : "Gita"
    ipa_path = "#{platform_dir}/build/#{ipa_name}.ipa"

    unless publish_to_store
      UI.message("publish:false for platform_dir=#{platform_dir} — build/sign only, skipping deliver")
      next
    end

    deliver(
      ipa: ipa_path,
      skip_screenshots: true,
      skip_metadata: false,
      force: true
    )
  end
end
