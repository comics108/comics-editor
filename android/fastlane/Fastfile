# Публикация Comics Editor в Google Play.
# Запуск: .github/workflows/release.yml (job release-android), вручную через
# workflow_dispatch. Локально: `cd android && bundle exec fastlane android deploy track:internal`
# (нужны те же переменные окружения, что использует CI — см. release.yml).
#
# applicationId: net.nativemind.comics.editor (android/app/build.gradle.kts,
# android/fastlane/Appfile). Перед первым реальным релизом:
#   1. Создать приложение в Google Play Console с этим package name, один раз
#      загрузить .aab вручную (Google Play не разрешает первую публикацию через API).
#   2. Настроить секреты в GitHub (Settings → Secrets and variables → Actions):
#        PLAY_STORE_JSON_KEY      — service account JSON (Play Console → API access)
#        ANDROID_KEYSTORE_BASE64  — release-keystore, закодированный в base64
#        ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
#      и переменную ANDROID_PACKAGE_NAME (по умолчанию net.nativemind.comics.editor,
#      переопределяется только если package name в сторе будет отличаться).
#
# Скриншоты (sdd-comics-editor-publish): fastlane/metadata/android/<locale>/images/,
# 5 локалей (ru-RU, en-US, zh-CN, hi-IN, th) — copies of design/store/googleplay-01-1440x2560.png
# (phoneScreenshots/1.png) и googleplay-cover-1024x500.png (featureGraphic.png). Одни и те же
# изображения на все локали (переводов текста на скриншотах нет).
#
# Текстовые метаданные (sdd-comics-editor-publish, 2026-07-31): fastlane/metadata/android/<locale>/
# {title,short_description,full_description}.txt для тех же 5 локалей. ru-RU/en-US написаны
# носителем-уровня уверенности; zh-CN/hi-IN/th — черновой перевод, **нужна проверка носителем
# языка перед реальной публикацией**. Категория Google Play не входит в этот текстовый набор —
# fastlane/supply её не поддерживает через файлы, задаётся вручную в Play Console (рекомендация:
# Art & Design).

default_platform(:android)

platform :android do
  desc "Собрать release App Bundle и опубликовать в Google Play"
  lane :deploy do |options|
    track = options[:track] || "internal"

    gradle(
      task: "bundle",
      build_type: "Release"
    )

    upload_to_play_store(
      track: track,
      aab: "app/build/outputs/bundle/release/app-release.aab"
    )
  end
end
