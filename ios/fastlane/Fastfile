# Публикация Comics Editor в App Store / TestFlight.
# Запуск: .github/workflows/release.yml (job release-ios), вручную через
# workflow_dispatch. Локально: `cd ios && bundle exec fastlane ios deploy lane:testflight`
# (нужны те же переменные окружения, что использует CI — см. release.yml).
#
# Код-сайнинг — БЕЗ match (sdd-comics-editor-publish, 2026-07-31, по решению пользователя):
# сертификат + provisioning profile передаются напрямую через секреты GitHub, тем же способом,
# каким android/fastlane уже сайнит keystore — никакого отдельного git-репозитория для
# сертификатов не заводится. `release.yml` декодирует `IOS_CERT_P12_BASE64`/
# `IOS_PROVISIONING_PROFILE_BASE64` в файлы `ios_distribution.p12`/`ios_appstore.mobileprovision`
# в этой же рабочей директории (`ios/`) перед вызовом лейна — см. release.yml.
#
# Внутри лейна: `create_keychain` создаёт временный keychain на раннере → `import_certificate`
# кладёт туда сертификат → UUID/Name profile'а вытаскиваются через `security cms -D`+`plutil`
# (без догадок о возвращаемом значении fastlane-экшена) → profile копируется в
# `~/Library/MobileDevice/Provisioning Profiles/<uuid>.mobileprovision` (стандартное для Xcode
# место) → `build_app` собирается с `export_options: signingStyle: manual` + `xcargs` явно
# задающими `CODE_SIGN_STYLE`/`PROVISIONING_PROFILE_SPECIFIER`/`CODE_SIGN_IDENTITY`. Этот путь
# (extract UUID из profile → xcargs) — распространённый, задокументированный паттерн для
# match-free CI-сайнинга, но **не проверен реальным прогоном** (агент не может собрать реальный
# iOS-архив локально) — если первый реальный прогон упадёт именно на этом шаге, здесь есть
# полный план того, что должно происходить, для быстрой диагностики отклонения.
#
# Bundle id: net.nativemind.comics.editor (ios/Runner.xcodeproj, ios/fastlane/Appfile).
# Перед первым реальным релизом:
#   1. Создать App ID net.nativemind.comics.editor в Apple Developer Portal и
#      приложение с этим bundle id в App Store Connect.
#   2. Создать Distribution-сертификат (Apple Developer Portal → Certificates), экспортировать
#      как .p12 из Keychain Access (с паролем — это и есть IOS_CERT_PASSWORD), закодировать в
#      base64: `base64 -i distribution.p12 | pbcopy`.
#   3. Создать App Store provisioning profile под net.nativemind.comics.editor, скачать
#      .mobileprovision, закодировать: `base64 -i profile.mobileprovision | pbcopy`.
#   4. Настроить секреты в GitHub (Settings → Secrets and variables → Actions):
#        ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT — App Store Connect API key
#          (App Store Connect → Users and Access → Keys; ASC_KEY_CONTENT — .p8 в base64)
#        IOS_CERT_P12_BASE64, IOS_CERT_PASSWORD           — из шага 2
#        IOS_PROVISIONING_PROFILE_BASE64                  — из шага 3
#        SIGNING_KEYCHAIN_PASSWORD                         — любой пароль для временного keychain
#          на раннере (не привязан ни к чему внешнему, просто должен существовать)
#        APPLE_TEAM_ID, ASC_TEAM_ID                        — team id разработчика и App Store Connect
#      и переменную IOS_BUNDLE_ID (по умолчанию net.nativemind.comics.editor).
#
# Скриншоты (sdd-comics-editor-publish): fastlane/screenshots/<locale>/*.png,
# 5 локалей (ru, en-US, zh-Hans, hi, th) — копии design/store/appstore-01/02-1290x2796.png.
# Одна и та же пара изображений на все локали (полноценных переводов текста на скриншотах нет).
#
# Текстовые метаданные (sdd-comics-editor-publish, 2026-07-31): fastlane/metadata/<locale>/*.txt
# (name/subtitle/description/keywords/promotional_text/support_url/privacy_url) для тех же 5
# локалей + account-level (copyright.txt, primary_category.txt, review_information/). ru/en-US
# написаны носителем-уровня уверенности; zh-Hans/hi/th — черновой перевод, **нужна проверка
# носителем языка перед реальной публикацией** (не заблокировано на этом — публиковать можно,
# но текст мог получиться корявым). support_url/privacy_url указывают на
# comics.nativemind.net/support.html и /policy.html — страницы должны реально существовать
# на момент публикации, этот flow их не создаёт.

require "shellwords"
require "tmpdir"

default_platform(:ios)

platform :ios do
  desc "Собрать release-архив и опубликовать в TestFlight / App Store"
  lane :deploy do |options|
    distribution_lane = options[:lane] || "testflight"
    bundle_id = ENV["IOS_BUNDLE_ID"] && !ENV["IOS_BUNDLE_ID"].empty? ? ENV["IOS_BUNDLE_ID"] : "net.nativemind.comics.editor"

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    keychain_password = ENV["SIGNING_KEYCHAIN_PASSWORD"]
    UI.user_error!("SIGNING_KEYCHAIN_PASSWORD is not set") if keychain_password.nil? || keychain_password.empty?

    create_keychain(
      name: "ios_signing.keychain",
      password: keychain_password,
      default_keychain: false,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    import_certificate(
      certificate_path: "ios_distribution.p12",
      certificate_password: ENV["IOS_CERT_PASSWORD"],
      keychain_name: "ios_signing.keychain",
      keychain_password: keychain_password
    )

    # Достаём UUID/Name из profile'а напрямую через security/plutil, а не полагаясь на
    # предположения о возвращаемом значении install_provisioning_profile.
    profile_plist = sh("security cms -D -i ios_appstore.mobileprovision", log: false)
    profile_uuid = nil
    profile_name = nil
    Dir.mktmpdir do |dir|
      plist_path = File.join(dir, "profile.plist")
      File.write(plist_path, profile_plist)
      profile_uuid = sh("plutil -extract UUID raw #{plist_path.shellescape}", log: false).strip
      profile_name = sh("plutil -extract Name raw #{plist_path.shellescape}", log: false).strip
    end
    UI.user_error!("Could not read UUID/Name from ios_appstore.mobileprovision") if profile_uuid.empty? || profile_name.empty?

    profiles_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    sh("mkdir -p #{profiles_dir.shellescape}")
    sh("cp ios_appstore.mobileprovision #{File.join(profiles_dir, "#{profile_uuid}.mobileprovision").shellescape}")

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: {
          bundle_id => profile_name
        }
      },
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' " \
              "PROVISIONING_PROFILE_SPECIFIER=#{profile_uuid.shellescape}"
    )

    if distribution_lane == "appstore"
      upload_to_app_store(
        api_key: api_key,
        force: true
      )
    else
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true
      )
    end
  end
end
