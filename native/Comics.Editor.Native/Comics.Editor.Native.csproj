<Project Sdk="Microsoft.NET.Sdk">

  <!-- SDD sdd-comics-editor-v2.9-android-ios, Task 1.1 (обвязка): NativeAOT-библиотека
       для мобильных платформ (и osx-dylib для тестов). Те же линкованные исходники,
       что у Comics.Editor.Headless; C-экспорты comics_call/comics_free (dart:ffi).
       Публикация: tool/build_native.sh (NativeLib задаётся при publish). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- iOS-публикация: tool/build_native.sh ios → -p:IncludeIos=true -f net10.0-ios
         (требует установленного workload: sudo dotnet workload install ios) -->
    <TargetFrameworks Condition="'$(IncludeIos)' == 'true'">net10.0;net10.0-ios</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">13.0</SupportedOSPlatformVersion>
    <RootNamespace>Comics.Editor.Headless</RootNamespace>
    <!-- ВАЖНО: как и у Headless — data.json содержит "$type": "..., Comics.Editor" -->
    <AssemblyName>Comics.Editor</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Reflection-сериализация Newtonsoft: ничего не срезать без корней из rd.xml -->
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="2.0.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <RdXmlFile Include="rd.xml" />
  </ItemGroup>

  <!-- Линкованные исходники (без изменений): те же, что у Comics.Editor.Headless -->
  <ItemGroup>
    <Compile Include="../Comics.Editor/Models/*.cs" LinkBase="Linked/Models" />
    <Compile Include="../Comics.Editor/Utils/FileManager.cs" Link="Linked/Utils/FileManager.cs" />
    <Compile Include="../Comics.Editor/Utils/ZipUtils.cs" Link="Linked/Utils/ZipUtils.cs" />
    <Compile Include="../Comics.Editor/IWS/Utils/Extensions.cs" Link="Linked/IWS/Extensions.cs" />
    <Compile Include="../Comics.Editor/IWS/Utils/Logger.cs" Link="Linked/IWS/Logger.cs" />
    <Compile Include="../Comics.Editor/IWS/Utils/SymmetricCrypt.cs" Link="Linked/IWS/SymmetricCrypt.cs" />
    <Compile Include="../Comics.Editor/IWS/Utils/ImageMagick.cs" Link="Linked/IWS/ImageMagick.cs" />
    <Compile Include="../Comics.Editor.Headless/Rpc.cs" Link="Linked/Rpc.cs" />
    <Compile Include="../Comics.Editor.Headless/WpfShims.cs" Link="Linked/WpfShims.cs" />
  </ItemGroup>

</Project>
