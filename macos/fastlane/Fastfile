# Публикация Comics Editor в Mac App Store.
# Запуск: .github/workflows/release.yml (job release-macos), вручную через
# workflow_dispatch. Локально: `cd macos && bundle exec fastlane macos deploy`
# (нужны те же переменные окружения, что использует CI — см. release.yml).
#
# Код-сайнинг — БЕЗ match (sdd-comics-editor-publish, 2026-07-31, по решению пользователя,
# тот же переход что и в ios/fastlane/Fastfile): сертификаты + provisioning profile идут напрямую
# через секреты GitHub. Mac App Store отличается от iOS тем, что нужны ДВЕ отдельные identity —
# "3rd Party Mac Developer Application" для подписи самого .app и "3rd Party Mac Developer
# Installer" для подписи .pkg — обе создаются и экспортируются отдельно в Apple Developer Portal.
#
# Bundle id: net.nativemind.comics.editor (macos/Runner/Configs/AppInfo.xcconfig,
# macos/fastlane/Appfile) — тот же, что у iOS/Android, новый identifier не заводился.
# App Sandbox уже включён (macos/Runner/Release.entitlements,
# com.apple.security.app-sandbox) — обычно самое частое препятствие для Mac App
# Store уже устранено, этому flow не пришлось его добавлять.
#
# ВАЖНО — почему это НЕ build_mac_app()+upload_to_app_store() напрямую (как в
# ios/fastlane/Fastfile): реальная функциональность приложения (открытие/
# сохранение .comics/.puzzle) зависит от C#-headless-ядра, которое встраивается
# в собранный .app СОВСЕМ ОТДЕЛЬНЫМ шагом (tool/build_headless.sh) уже ПОСЛЕ
# того, как `flutter build macos`/Xcode заканчивает сборку и подписывает бандл —
# в Xcode-проекте нет build-фазы, которая бы это делала (сверено:
# macos/Runner.xcodeproj/project.pbxproj содержит только стандартные
# Flutter-фазы, `macos_assemble.sh`). Если бы этот lane просто вызвал
# `build_mac_app` (архивирует и подписывает всё сразу) и следом `upload_to_app_store`,
# в Mac App Store ушла бы сборка БЕЗ ядра — она бы успешно собралась, подписалась
# и загрузилась, и оказалась бы нерабочей только когда кто-то реально попробовал
# бы открыть файл. tool/build_headless.sh для CI-артефактов (build.yml) решает
# это повторной ad-hoc подписью (`codesign --sign -`) ПОСЛЕ встраивания ядра —
# для Mac App Store ad-hoc недостаточно, нужна настоящая identity из match.
#
# Поэтому здесь сборка разбита на явные шаги в правильном порядке (ядро
# встраивается ДО финальной подписи, не после):
#   1. `flutter build macos --release` напрямую (не через build_mac_app) —
#      тот же вызов, что уже проверен в build.yml's build-macos job.
#   2. dotnet publish headless-ядра + копирование в Contents/Resources/comics-core/
#      — та же логика, что tool/build_headless.sh уже делает для CI-артефактов
#      (см. этот скрипт), но БЕЗ его финальной ad-hoc подписи — она здесь не нужна,
#      следующий шаг подписывает по-настоящему.
#   3. Найти codesigning identity, которую match только что установил в keychain
#      (Apple всегда называет Mac App Store app-сертификат с префиксом
#      "3rd Party Mac Developer Application:", это стабильно независимо от team
#      name — не хардкодим сам team name), подписать .app целиком этой identity.
#   4. Собрать подписанный `.pkg` (`productbuild`) второй, ОТДЕЛЬНОЙ installer-
#      identity ("3rd Party Mac Developer Installer:" — Apple требует для Mac
#      App Store submission именно .pkg, не голый .app, и именно этой отдельной
#      identity, не той же что у app).
#   5. `upload_to_app_store(pkg: ...)` — как ios-лейн, но с готовым pkg вместо
#      автоматического build_mac_app-экспорта.
#
# Эта последовательность НЕ проверена реальным прогоном (агент работает без
# доступа к Mac Developer аккаунту/match-репозиторию/App Store Connect) — шаги
# 1-2 напрямую переиспользуют уже проверенную в CI логику (build.yml,
# tool/build_headless.sh), шаги 3-5 новые и нуждаются в первом реальном прогоне
# для подтверждения (см. _status.md sdd-comics-editor-publish).
#
# Перед первым реальным релизом:
#   1. Завести отдельную запись macOS-приложения в App Store Connect под
#      net.nativemind.comics.editor — это ОТДЕЛЬНАЯ запись от iOS-приложения
#      с тем же bundle id (App Store Connect различает платформы), сделать
#      руками, API это не создаёт.
#   2. В Apple Developer Portal создать ОБЕ identity — "Mac App Distribution"
#      (для .app) и "Mac Installer Distribution" (для .pkg) — экспортировать каждую
#      как отдельный .p12 из Keychain Access (можно с разными или одним паролем),
#      закодировать в base64 каждый: `base64 -i cert.p12 | pbcopy`.
#   3. Создать Mac App Store provisioning profile под net.nativemind.comics.editor,
#      скачать .provisionprofile, закодировать в base64.
#   4. Секреты в GitHub (отдельные от ios/fastlane — разные certs/profile, тот же
#      Apple Developer team/ASC-ключ можно переиспользовать):
#        ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT — тот же ключ, что у release-ios
#        MACOS_CERT_APP_P12_BASE64, MACOS_CERT_APP_PASSWORD             — из шага 2 (app cert)
#        MACOS_CERT_INSTALLER_P12_BASE64, MACOS_CERT_INSTALLER_PASSWORD — из шага 2 (installer cert)
#        MACOS_PROVISIONING_PROFILE_BASE64                              — из шага 3
#        SIGNING_KEYCHAIN_PASSWORD — тот же, что у release-ios, можно переиспользовать значение
#        APPLE_TEAM_ID, ASC_TEAM_ID — те же, что у release-ios
#
# Скриншоты: fastlane/screenshots/<locale>/*.png, 5 локалей (ru, en-US, zh-Hans,
# hi, th) — копии design/store/pc-01-1440x900.png (валидный размер для Mac App
# Store screenshot, ресайз не нужен). Одно и то же изображение на все локали.
#
# Текстовые метаданные (sdd-comics-editor-publish, 2026-07-31): fastlane/metadata/<locale>/*.txt,
# те же 5 локалей — тот же контент, что в ios/fastlane/metadata/ (тот же продукт, отдельная
# App Store Connect запись под ту же связку review_information/copyright/category). ru/en-US
# написаны носителем-уровня уверенности; zh-Hans/hi/th — черновой перевод, **нужна проверка
# носителем языка перед реальной публикацией**.

require "shellwords"

default_platform(:macos)

platform :macos do
  desc "Собрать release-архив (с встроенным headless-ядром) и опубликовать в Mac App Store"
  lane :deploy do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    keychain_password = ENV["SIGNING_KEYCHAIN_PASSWORD"]
    UI.user_error!("SIGNING_KEYCHAIN_PASSWORD is not set") if keychain_password.nil? || keychain_password.empty?

    create_keychain(
      name: "macos_signing.keychain",
      password: keychain_password,
      default_keychain: false,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    import_certificate(
      certificate_path: "macos_app.p12",
      certificate_password: ENV["MACOS_CERT_APP_PASSWORD"],
      keychain_name: "macos_signing.keychain",
      keychain_password: keychain_password
    )
    import_certificate(
      certificate_path: "macos_installer.p12",
      certificate_password: ENV["MACOS_CERT_INSTALLER_PASSWORD"],
      keychain_name: "macos_signing.keychain",
      keychain_password: keychain_password
    )

    # Шаг 1 — тот же вызов, что build.yml's build-macos job уже использует.
    # Fastlane запускает lane с cwd = macos/ (родитель fastlane/, тот же принцип,
    # что уже используют голые пути "Runner.xcworkspace" в ios/fastlane/Fastfile) —
    # `flutter build` нужен pubspec.yaml, поэтому явный `cd ..`.
    sh("cd .. && flutter build macos --release")

    app_path = Dir.glob("../build/macos/Build/Products/Release/*.app").first
    UI.user_error!("comics_editor.app not found after flutter build macos") if app_path.nil?

    # Шаг 2 — публикация + встраивание headless-ядра, та же логика что
    # tool/build_headless.sh (см. этот скрипт), но без его ad-hoc-подписи —
    # финальная подпись (шаг 4) подписывает по-настоящему.
    sh("cd .. && dotnet publish " \
       "native/Comics.Editor.Headless/Comics.Editor.Headless.csproj " \
       "-c Release -r osx-arm64 --self-contained true " \
       "-p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true " \
       "-o native/Comics.Editor.Headless/publish/osx-arm64")
    core_dir = File.join(app_path, "Contents/Resources/comics-core")
    sh("mkdir -p #{core_dir.shellescape}")
    sh("cp ../native/Comics.Editor.Headless/publish/osx-arm64/Comics.Editor #{core_dir.shellescape}/")

    # Шаг 3 — встраивание provisioning profile'я. Mac App Store требует его внутри
    # бандла (Contents/embedded.provisionprofile), так же как iOS требует его в .ipa —
    # это не зависело от match/no-match, но раньше явно не делалось (найдено и
    # исправлено при переходе с match, sdd-comics-editor-publish 2026-07-31).
    sh("cp macos_appstore.provisionprofile #{File.join(app_path, 'Contents/embedded.provisionprofile').shellescape}")

    # Шаг 4 — реальная подпись всего .app (включая только что встроенное ядро и
    # profile) только что импортированной identity. Ищем по стабильному
    # Apple-префиксу, а не по team name (не хардкодим конкретное имя компании).
    app_identity = sh("security find-identity -v -p codesigning | " \
      "grep '3rd Party Mac Developer Application' | head -1 | " \
      "awk -F'\"' '{print $2}'", log: false).strip
    UI.user_error!("No '3rd Party Mac Developer Application' identity found in keychain " \
      "-- did MACOS_CERT_APP_P12_BASE64 import correctly?") if app_identity.empty?
    sh("codesign --force --deep --sign #{app_identity.shellescape} #{app_path.shellescape}")

    # Шаг 5 — .pkg для App Store Connect, отдельной installer-identity.
    installer_identity = sh("security find-identity -v -p basic | " \
      "grep '3rd Party Mac Developer Installer' | head -1 | " \
      "awk -F'\"' '{print $2}'", log: false).strip
    UI.user_error!("No '3rd Party Mac Developer Installer' identity found in keychain " \
      "-- did MACOS_CERT_INSTALLER_P12_BASE64 import correctly?") if installer_identity.empty?
    pkg_path = File.join(File.dirname(app_path), "comics_editor.pkg")
    sh("productbuild --component #{app_path.shellescape} /Applications " \
       "--sign #{installer_identity.shellescape} #{pkg_path.shellescape}")

    # Шаг 6.
    upload_to_app_store(
      api_key: api_key,
      pkg: pkg_path,
      force: true
    )
  end
end
